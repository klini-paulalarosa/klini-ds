{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "klini-ds-docs": {
      "projectType": "application",
      "root": "projects/klini-ds-docs",
      "sourceRoot": "projects/klini-ds-docs/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:application",
          "options": {
            "outputPath": "dist/klini-ds-docs",
            "index": "projects/klini-ds-docs/src/index.html",
            "browser": "projects/klini-ds-docs/src/main.ts",
            "polyfills": ["zone.js"],
            "tsConfig": "projects/klini-ds-docs/tsconfig.app.json",
            "assets": [
              { "glob": "**/*", "input": "projects/klini-ds-docs/public" }
            ],
            "styles": ["projects/klini-ds-docs/src/styles.scss"],
            "scripts": []
          },
          "configurations": {
            "production": {
              "budgets": [
                { "type": "initial", "maximumWarning": "3.5mb", "maximumError": "6mb" },
                { "type": "anyComponentStyle", "maximumWarning": "8kb", "maximumError": "16kb" }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "configurations": {
            "production": { "buildTarget": "klini-ds-docs:build:production" },
            "development": { "buildTarget": "klini-ds-docs:build:development" }
          },
          "defaultConfiguration": "development"
        }
      }
    },
    "klini-ds": {
      "projectType": "library",
      "root": "projects/klini-ds",
      "sourceRoot": "projects/klini-ds/src",
      "prefix": "klini",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:ng-packagr",
          "options": {
            "project": "projects/klini-ds/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "projects/klini-ds/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/klini-ds/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "tsConfig": "projects/klini-ds/tsconfig.spec.json",
            "karmaConfig": "projects/klini-ds/karma.conf.js"
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": [
              "projects/klini-ds/**/*.ts",
              "projects/klini-ds/**/*.html"
            ],
            "eslintConfig": "projects/klini-ds/eslint.config.js"
          }
        }
      }
    }
  },
  "cli": {
    "schematicCollections": [
      "angular-eslint"
    ]
  }
}
