{
  "name": "klini-ds-workspace",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "ng build klini-ds --configuration production",
    "build:watch": "ng build klini-ds --watch",
    "test": "ng test klini-ds",
    "lint": "ng lint klini-ds",
    "sync-tokens": "node scripts/sync-tokens.mjs",
    "release:patch": "npm version patch --prefix projects/klini-ds && git push origin main --tags",
    "release:minor": "npm version minor --prefix projects/klini-ds && git push origin main --tags",
    "release:major": "npm version major --prefix projects/klini-ds && git push origin main --tags"
  },
  "dependencies": {
    "@angular/animations": "^18.2.0",
    "@angular/common": "^18.2.0",
    "@angular/core": "^18.2.0",
    "@angular/forms": "^18.2.0",
    "@primeng/themes": "^18.0.0",
    "primeicons": "^7.0.0",
    "primeng": "^18.0.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^18.2.0",
    "@angular/cli": "^18.2.0",
    "@angular/compiler": "^18.2.0",
    "@angular/compiler-cli": "^18.2.0",
    "angular-eslint": "21.0.1",
    "eslint": "^9.39.1",
    "ng-packagr": "^18.0.0",
    "sass": "^1.77.0",
    "typescript": "~5.5.0",
    "typescript-eslint": "8.46.4"
  }
}